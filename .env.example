# ───────────── Banco de dados (Supabase / Postgres) ─────────────
# Supabase → botão "Connect" → "Transaction pooler" (porta 6543).
# Troque [SUA-SENHA] pela senha do banco (Project Settings → Database).
# Vazio = Postgres embutido em ./data/pglite (só para desenvolvimento local).
DATABASE_URL=""

# ───────────── Painel admin ─────────────
# Usado só pelo "npm run db:seed" para criar o primeiro acesso.
ADMIN_EMAIL="admin@laribrows.com"
ADMIN_PASSWORD="troque-esta-senha"
# Gere com: openssl rand -base64 32
SESSION_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# ───────────── Site ─────────────
# URL pública (usada nos retornos e webhook do Mercado Pago)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────────── Mercado Pago (PIX automático + cartão de crédito) ─────────────
# Sem token o sistema roda em MODO SIMULAÇÃO (bom para testar).
# Painel: https://www.mercadopago.com.br/developers/panel/app → Credenciais de produção
MP_ACCESS_TOKEN=""
# Assinatura secreta do webhook (Suas integrações → Webhooks)
MP_WEBHOOK_SECRET=""

# ───────────── Supabase Auth (área da cliente) ─────────────
# Project Settings → API Keys (chave "publishable", pública por natureza)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
