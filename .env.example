# ───────────── Banco de dados (Supabase / Postgres) ─────────────
# Supabase → botão "Connect" → "Transaction pooler" (porta 6543).
# Troque [SUA-SENHA] pela senha do banco (Project Settings → Database).
# Vazio = Postgres embutido em ./data/pglite (só para desenvolvimento local).
DATABASE_URL=""

# ───────────── Painel admin ─────────────
# Usado só pelo "npm run db:seed" para criar o primeiro acesso.
ADMIN_EMAIL="admin@laribrows.com"
ADMIN_PASSWORD="troque-esta-senha"
# Gere com: openssl rand -base64 32
SESSION_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# ───────────── E-mails do sistema (Resend) ─────────────
# Usado no "Esqueci minha senha" do painel. resend.com → API Keys (domínio verificado no Resend).
RESEND_API_KEY=""
EMAIL_FROM="Lari Brows <contato@seudominio.com.br>"

# ───────────── CAPTCHA do login da cliente (Cloudflare Turnstile) ─────────────
# Chave pública (Site Key) do widget. A chave secreta fica só no Supabase
# (Authentication → Attack Protection → Captcha). Vazio = sem CAPTCHA.
TURNSTILE_SITE_KEY=""

# ───────────── WhatsApp (Evolution API) ─────────────
# Confirmações, lembretes e avisos automáticos. Use o TOKEN DA INSTÂNCIA (não a chave geral do servidor).
EVOLUTION_API_URL=""
EVOLUTION_INSTANCE=""
EVOLUTION_API_KEY=""

# ───────────── Site ─────────────
# Endereço público do site (retorno do pagamento, avisos da InfinitePay e links de login)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────────── InfinitePay (PIX + cartão de crédito) ─────────────
# Sua InfiniteTag, sem o "$" (ex.: laribrows). Sem ela, PIX/cartão online ficam indisponíveis
# (a "Chave PIX própria" do painel continua funcionando).
INFINITEPAY_HANDLE=""
# Recomendada (começa com inchk_): tira a etapa "endereço de entrega" do pagamento e faz o link
# expirar junto com a reserva. InfinitePay → Configurações do Checkout → ative o Checkout Integrado
# → crie uma API Key. Ela aparece uma vez só. Nunca coloque no navegador nem no GitHub.
INFINITEPAY_API_KEY=""

# Simulação de pagamentos (botão "aprovar" sem cobrar). Use "true" SÓ no computador de testes.
# No site publicado deixe "false" (ou não defina).
ALLOW_PAYMENT_SIMULATION="false"

# ───────────── Mercado Pago (alternativa à InfinitePay) ─────────────
# Sem token o sistema roda em MODO SIMULAÇÃO (bom para testar).
# Painel: https://www.mercadopago.com.br/developers/panel/app → Credenciais de produção
MP_ACCESS_TOKEN=""
# Assinatura secreta do webhook (Suas integrações → Webhooks)
MP_WEBHOOK_SECRET=""

# ───────────── Supabase Auth (área da cliente) ─────────────
# Project Settings → API Keys (chave "publishable", pública por natureza)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
